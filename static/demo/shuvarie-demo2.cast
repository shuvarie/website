[0.021, "o", "\u001b[2;36H\u001b[48;2;26;40;30m         \u001b[3;34H\u001b[49m                                                                                \u001b[4;36H\u001b[48;2;26;40;30m  \u001b[5;36H\u001b[38;2;138;146;90;1m✓\u001b[39;22m \u001b[38;2;224;216;196;1m$ cargo clippy --workspace --all-targets > /tmp/clippy_ws.log 2>&1; echo\u001b[39;22m  \u001b[6;36H\u001b[38;2;224;216;196;1m\"EXIT=$?\"; grep -n \"^warning\\|^error\\|-->\\|Finished\" /tmp/clippy_ws.log |\u001b[7;36Hhead -60\u001b[39;22m \u001b[38;2;92;86;74mtimeout=2400s · spawn 2\u001b[39m                                       \u001b[8;37H\u001b[38;2;128;120;104m2:warning: this `MutexGuard` i\u001b[8;68H held across an awai\u001b[8;89H point\u001b[39m             \u001b[9;37H\u001b[38;2;128;120;104m3:    --> crates/core/tests/core_task.rs:3514:9\u001b[10;36H20:    --> crates/core/tests/core_task.rs:3589:20\u001b[39m                           \u001b[11;36H\u001b[38;2;128;120;104m27:warning: `shuvarie-core` (test \"core_task\") generated 1 warning\u001b[12;36H28:    Finished `dev` profile [unoptimized + debuginfo] target(s) in 14.12s\u001b[13;36H\u001b[38;2;92;86;74;3m… +1 more lines\u001b[14;34H\u001b[39;23m  \u001b[38;2;92;86;74;3m  Took 14.3s\u001b[39;23m                                                                  \u001b[15;34H                                                                                \u001b[16;34H\u001b[49m                                                                                \u001b[17;36H\u001b[48;2;38;38;46m                                                                         \u001b[18;36H\u001b[38;2;212;175;95m⠴\u001b[39m \u001b[38;2;224;216;196;1m$ git status --short; echo ---; git diff README.md | head -60\u001b[38;2;92;86;74;22m · spawn 2\u001b[19;36H\u001b[38;2;128;120;104m M README.md\u001b[20;36H M crates/core/src/scenes.rs\u001b[21;36H M crates/core/src/tools.rs\u001b[22;34H\u001b[39m  \u001b[38;2;128;120;104m M crates/core/src/tools/grep.rs\u001b[