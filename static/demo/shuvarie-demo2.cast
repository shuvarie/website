2mp\u001b[13;96Hth\u001b[49m must be\u001b[13;107Ha\u001b[39m  \u001b[14;34H\u001b[38;2;224;216;196mdirecto\u001b[14;42Hy.\u001b[39m                                                                \u001b[15;34H\u001b[38;2;212;175;95;1m• \u001b[38;2;224;216;196;22mTwo FFF behaviours are corrected for tool use: a 1-character query (FFF treats\u001b[16;34Hit as\u001b[16;40H\u001b[3mempty\u001b[23m and would \u001b[16;57Hank ev\u001b[16;64Hry file by recency) is rejected with a\u001b[16;103Hclear\u001b[39m      \u001b[17;34H\u001b[38;2;224;216;196mmessage, and equally-scored hits\u001b[17;67Hare re-sort\u001b[17;79Hd by\u001b[17;84Hpath so ident\u001b[17;98Hcal ca\u001b[17;105Hls answer\u001b[18;34Hidentically.\u001b[39m                                                                    \u001b[19;34H\u001b[38;2;224;216;196;1mWiring\u001b[39;22m      \u001b[20;34H      \u001b[21;34H\u001b[38;2;212;175;95;1m• \u001b[38;2;224;216;196;48;2;52;48;42m\u001b[22mtools.rs\u001b[49m: module + \u001b[48;2;52;48;42mFuzzyFind\u001b[49m, registered in \u001b[48;2;52;48;42mall_tools\u001b[49m and \u001b[48;2;52;48;42mread_tools\u001b[49m (so\u001b[22;34Hsubagent read workers get it), and \u001b[22;70Hn th\u001b[22;75H roster test. \u001b[48;2;52;48;42mis_hidden\u001b[49m/\u001b[48;2;52;48;42mdisplay_path\u001b[23;34H\u001b[49mmoved here from \u001b[48;2;52;48;42mgrep.rs\u001b[49m (renamed \u001b[48;2;52;48;42mis_hidden_path\u001b[49m)\u001b[23;83Hsince\u001b[23;89Hboth tools need them.\u001b[39m \u001b[24;34H\u001b[38;2;212;175;95;1m• \u001b[38;2;224;216;196;48;2;52;48;42m\u001b[22mscenes.rs\u001b[49m:\u001b[39m                                                          \u001b[30;33H\u001b[38;2;212;175;95m⠚\u001b[30;36H⢁\u001b[30;39H⡤\u001b[m\u001b[?25l"]
