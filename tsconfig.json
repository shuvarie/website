{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		/* Mirror the `imports` map in package.json. Vite resolves it on its own,
		   but TypeScript's bundler resolution needs an explicit `paths` entry. */
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts", "mdx-plugins.ts"]
}
